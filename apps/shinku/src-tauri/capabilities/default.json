{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Ce que la fenêtre de Shinku a le droit de demander : ses vingt-trois commandes, et les gestes de sa barre de titre (déplacer, réduire, agrandir, fermer). Rien d'autre : ni fichiers, ni réseau. Seuls l'agent du mode jeu (shinku-agent.exe, à côté de Shinku) et deux pages fixes des réglages de Windows (mode Jeu, alimentation) peuvent être lancés.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "allow-overview",
    "allow-acknowledge-settings-issue",
    "allow-start-scan",
    "allow-cancel-scan",
    "allow-session-view",
    "allow-clean-preview",
    "allow-start-clean",
    "allow-cancel-clean",
    "allow-junk-details",
    "allow-large-files-page",
    "allow-duplicates-page",
    "allow-set-theme",
    "allow-add-excluded-folder",
    "allow-remove-excluded-folder",
    "allow-game-view",
    "allow-set-game-option",
    "allow-set-quiet-app",
    "allow-open-apps",
    "allow-add-game",
    "allow-add-quiet-app",
    "allow-set-game-status",
    "allow-release-game",
    "allow-open-windows-settings"
  ]
}
